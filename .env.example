# ===================================
# GPT Team 管理系统 - 环境变量配置
# ===================================
# 复制此文件为 .env 并填写实际值
# cp .env.example .env

# ----- 应用配置 -----
APP_NAME="GPT Team 管理系统"
APP_VERSION="0.1.0"
APP_HOST=0.0.0.0
APP_PORT=8008
DEBUG=false

# ----- 安全配置 -----
# 重要: 生产环境必须修改这些值!
SECRET_KEY=your-super-secret-key-change-this-in-production
ADMIN_PASSWORD=wasd123456

# ----- 数据库配置 -----
# SQLite (默认)
DATABASE_URL=sqlite+aiosqlite:///./data/team_manage.db
# PostgreSQL (可选，用于生产环境)
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/team_manage

# ----- 代理配置 -----
PROXY=
PROXY_ENABLED=false

# ----- JWT 配置 -----
JWT_VERIFY_SIGNATURE=false

# ----- 时区配置 -----
TIMEZONE=Asia/Shanghai

# ----- 日志配置 -----
LOG_LEVEL=INFO

# ----- HTTPS 配置 -----
# 生产环境设为 true
HTTPS_ONLY=false
